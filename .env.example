# GeoTech deployment — copy to .env and fill in (NEVER commit .env).
#   cp .env.example .env
#
# Only SECRET_KEY, SUPERADMIN_* and FRONTEND_URL normally need changing.
# Everything else already has a working default for an IP-based test server.

# --- Runtime mode (keep "production" inside Docker) ---
ENV=production

# --- Database (SQLite on a persistent Docker volume; keep as-is) ---
DATABASE_URL=sqlite:////data/geotech.db

# --- Security (SECRET) — generate a fresh value per server, min 32 chars.
# Example:  python3 -c "import secrets; print(secrets.token_hex(32))" ---
SECRET_KEY=change-me-to-a-long-random-value-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- First superadmin (created automatically on first backend start) ---
SUPERADMIN_EMAIL=admin@geotech.com
SUPERADMIN_PASSWORD=change-me-to-a-strong-password
SUPERADMIN_NAME=superadmin

# --- Mail (optional) ---
# Invites/OTP use these. If left empty, the app still runs: invites are
# created and e-mail delivery is attempted in the background (failures are
# logged, never fatal). Password-reset codes then only work once real
# SMTP credentials are configured.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=GeoTech <noreply@geotech.com>

# --- URLs ---
# MUST be the public address of the server (used in invitation e-mails and
# for CORS). No trailing slash.
FRONTEND_URL=http://YOUR_SERVER_IP
# Extra browser origins allowed to call the API directly, comma-separated
# (optional, e.g. a Vercel preview URL). Same-origin /api/ traffic needs none.
CORS_EXTRA_ORIGINS=
ORGANIZATION_NAME=GeoTech
